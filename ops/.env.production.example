# Copy to an ignored .env.production; never commit credentials or dump rendered compose config.
RELEASE_TAG=replace_me_release_id
POSTGRES_DB=trade_ops
POSTGRES_USER=trade_ops_admin
POSTGRES_PASSWORD=replace_me_random_database_password
APP_DB_USER=trade_ops_app
APP_DB_PASSWORD=replace_me_separate_runtime_password
JWT_SECRET=replace_me_random_signing_secret_at_least_32_bytes
MAIL_OUTBOX_KEY=replace_me_base64_random_32_bytes
PUBLIC_ORIGIN=https://replace-me.invalid
# Absolute certificate paths on the Docker host.
TLS_CERT_FILE=/replace_me/fullchain.pem
TLS_KEY_FILE=/replace_me/privkey.pem
HTTPS_BIND_ADDRESS=0.0.0.0
# Keep false until the chosen SMTP provider and recipient are explicitly approved.
MAIL_DISPATCH_ENABLED=false
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# Optional supplier catalog integration. Keep blank to disable Domeggook lookup.
DOMEGGOOK_API_KEY=
# Optional PDF/image import. The bundled `documents` profile uses the same
# generated OBJECT_STORAGE_* credentials for MinIO.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=trade-ops-artifacts
OBJECT_STORAGE_PATH_STYLE=true
OBJECT_STORAGE_CREATE_BUCKET=false
OCR_ENABLED=false
OCR_BASE_URL=http://ocr-worker:8090
OCR_CONNECT_TIMEOUT_SECONDS=3
OCR_REQUEST_TIMEOUT_SECONDS=180
